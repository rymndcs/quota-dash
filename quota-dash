def parse_args(argv=None):
    """Parse the command line; argparse prints help/usage and exits itself."""
    parser = argparse.ArgumentParser(
        prog="quota-dash",
        description="A live terminal dashboard for subscription quotas and "
                    "DeepSeek credit.")
    parser.add_argument(
        "interval", nargs="?", type=int, default=60, metavar="SECONDS",
        help="refresh interval in seconds (default: %(default)s)")
    return parser.parse_args(argv)


ARGS = parse_args()
INTERVAL = ARGS.interval
HISTORY_GAP_SECONDS = max(INTERVAL * 2.5, 5 * 60)

try:
    from rich.align import Align
    from rich.console import Console, Group
    from rich.live import Live
    from rich.panel import Panel
    from rich.rule import Rule
    from rich.segment import Segment
    from rich.table import Table
    from rich.text import Text
except ImportError:
    sys.exit("quota-dash: rich is not installed — run `python3 -m pip install rich`")

DEEPSEEK_AUTH = Path.home() / ".quota-dash/auth.json"
LEGACY_DEEPSEEK_AUTH = Path.home() / ".pi/agent/auth.json"
DEEPSEEK_PEAK_HOURS_UTC = {1, 2, 3, 6, 7, 8, 9}   # double price in these windows
HISTORY_FILE = Path(os.environ.get(
    "QUOTA_DASH_HISTORY", Path.home() / ".cache/quota-dash/history.jsonl"))

console = Console()


# ---------------------------------------------------------------- data reads
def read_quota():
    try:
        out = subprocess.run(["quota-axi", "--json"], capture_output=True,
                             text=True, timeout=45).stdout
        return json.loads(out)
    except Exception:
        return None


def _balance(value):
    """Return a canonical non-negative decimal string, or raise ValueError."""
    try:
        number = Decimal(str(value))
    except (InvalidOperation, ValueError):
        raise ValueError("invalid balance") from None
    if not number.is_finite() or number < 0:
        raise ValueError("invalid balance")
    return format(number, "f")


def _deepseek_key():
    """Return (key, using legacy file); malformed/missing files are normal."""
    for path, legacy in ((DEEPSEEK_AUTH, False), (LEGACY_DEEPSEEK_AUTH, True)):
        try:
            key = json.loads(path.read_text()).get("deepseek", {}).get("key", "")
        except (AttributeError, OSError, TypeError, ValueError, json.JSONDecodeError):
            continue
        if isinstance(key, str) and key:
            return key, legacy
    return "", False


def read_deepseek():
    """Return (validated balance/status, availability, using legacy auth).

    The key is read here and never printed or returned.
    """
    key, legacy_auth = _deepseek_key()
    if not key:
        return ("unconfigured", "", False)
    try:
        import urllib.request
        req = urllib.request.Request(
            "https://api.deepseek.com/user/balance",
            headers={"Authorization": f"Bearer {key}"})
        with urllib.request.urlopen(req, timeout=10) as r:
            d = json.load(r)
        if not isinstance(d.get("is_available"), bool):
            raise ValueError("invalid availability")
        infos = d.get("balance_infos")
        if not isinstance(infos, list):
            raise ValueError("invalid balances")
        info = next((item for item in infos
                     if isinstance(item, dict) and item.get("currency") == "USD"), None)
        if info is None:
            raise ValueError("USD balance missing")
        balances = _clean_balances(info)
        return (balances, "yes" if d["is_available"] else "no", legacy_auth)
    except Exception:
        return ("unreachable", "", legacy_auth)


# --------------------------------------------------------------- history I/O
def _clean_balances(balances):
    clean = {key: _balance(balances[key]) for key in (
        "total_balance", "granted_balance", "topped_up_balance")}
    parts = Decimal(clean["granted_balance"]) + Decimal(clean["topped_up_balance"])
    if abs(Decimal(clean["total_balance"]) - parts) > Decimal("0.000001"):
        raise ValueError("balance components do not match total")
    return clean


def load_history(path=None, limit=20000, tail_bytes=4 * 1024 * 1024):
    """Read recent complete JSONL records; tolerate partial/concurrent writes."""
    path = path or HISTORY_FILE
    records = deque(maxlen=limit)
    try:
        with path.open("rb") as stream:
            size = stream.seek(0, os.SEEK_END)
            offset = max(0, size - tail_bytes)
            stream.seek(offset)
            if offset:
                stream.readline()  # discard a record cut by the bounded tail read
            for raw in stream:
                try:
                    item = json.loads(raw)
                    deepseek = item.get("deepseek")
                    datetime.fromisoformat(item["at"].replace("Z", "+00:00"))
                    if not isinstance(deepseek, dict):
                        continue
                    item["deepseek"] = _clean_balances(deepseek)
                    records.append(item)
                except (AttributeError, KeyError, TypeError, ValueError,
                        json.JSONDecodeError):
                    continue
    except OSError:
        pass
    return list(records)


def append_history(balances, path=None, at=None):
    """Append one validated DeepSeek sample with a single O_APPEND write."""
    path = path or HISTORY_FILE
    clean = _clean_balances(balances)
    stamp = at or datetime.now(timezone.utc)
    record = {"version": 1, "at": stamp.astimezone(timezone.utc).isoformat(),
              "deepseek": clean}
    line = (json.dumps(record, separators=(",", ":")) + "\n").encode()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(fd, line)
    finally:
        os.close(fd)
    return record


def deepseek_history(records, gap_seconds=HISTORY_GAP_SECONDS):
    """Return calendar-day direction totals and a usage-only daily burn rate."""
    days = defaultdict(lambda: {"usage": Decimal(0), "topups": Decimal(0),
                                "samples": 0, "gap": False})
    parsed = []
    for record in records:
        try:
            stamp = datetime.fromisoformat(record["at"].replace("Z", "+00:00"))
            if stamp.tzinfo is None:
                stamp = stamp.replace(tzinfo=timezone.utc)
            values = {key: Decimal(record["deepseek"][key]) for key in (
                "granted_balance", "topped_up_balance")}
        except (AttributeError, KeyError, TypeError, ValueError, InvalidOperation):
            continue
        parsed.append((stamp, values))
        days[stamp.astimezone().date()]["samples"] += 1

    parsed.sort(key=lambda sample: sample[0])
    events = []
    for (before_at, before), (after_at, after) in zip(parsed, parsed[1:]):
        if after_at <= before_at:
            continue
        day = after_at.astimezone().date()
        usage = sum((max(before[key] - after[key], Decimal(0))
                     for key in before), Decimal(0))
        topup = max(after["topped_up_balance"] - before["topped_up_balance"],
                    Decimal(0))
        days[day]["usage"] += usage
        days[day]["topups"] += topup
        if (after_at - before_at).total_seconds() > gap_seconds:
            days[day]["gap"] = True
        if topup:
            events.append((after_at, topup))

    ordered = sorted(days.items())
    usage = sum((values["usage"] for _, values in ordered), Decimal(0))
    burn = usage / len(ordered) if ordered else Decimal(0)
    return ordered, events, burn


# ------------------------------------------------------------------ helpers
def as_local(iso):
    if not iso or iso == "unknown":
        return None
    try:
        return datetime.fromisoformat(str(iso).replace("Z", "+00:00")).astimezone()
    except Exception:
        return None


def span(hours):
    if hours < 1:
        return f"{hours * 60:.0f}m"
    if hours < 6:
        return f"{int(hours)}h {(hours % 1) * 60:.0f}m"
    if hours < 48:
        return f"{hours:.0f}h"
    return f"{hours / 24:.1f}d"


def gauge(pct, width=26):
    pct = max(0.0, min(100.0, float(pct)))
    filled = round(width * pct / 100)
    colour = "green" if pct >= 50 else ("yellow" if pct >= 20 else "red")
    t = Text()
    t.append("[", style="dim")
    t.append("█" * filled, style=colour)
    t.append("░" * (width - filled), style="dim")
    t.append("]", style="dim")
    return t


def dot(pct):
    return "🟢" if pct >= 50 else ("🟡" if pct >= 20 else "🔴")


def heading(icon, title, subtitle):
    t = Text()
    t.append(f"{icon} ")
    t.append(title, style="bold")
    t.append(f"    {subtitle}", style="dim")
    return t


# ------------------------------------------------------------------ sections
def windows_table(live_providers, now=None):
    t = Table(box=None, pad_edge=False, show_header=False, padding=(0, 1, 1, 1))
    t.add_column(width=18)
    t.add_column(width=2)
    t.add_column(width=28)
    t.add_column(justify="right", width=6)
    t.add_column()

    rows = []
    now = now or datetime.now().astimezone()
    for p in live_providers:
        prov = (p.get("provider") or "?").capitalize()
        for w in p.get("windows", []):
            pct = w.get("percentRemaining")
            if not isinstance(pct, (int, float)):
                continue
            rows.append((prov, w))
            label = f"{prov} {(w.get('label') or w.get('id') or '')}".strip()
            reset = as_local(w.get("resetsAt"))
            when = Text()
            if reset:
                hrs = (reset - now).total_seconds() / 3600
                stamp = reset.strftime("%H:%M") if hrs < 24 else reset.strftime("%a %H:%M")
                when.append(stamp)
                when.append(f"   in {span(hrs)}", style="dim")
            t.add_row(label, dot(pct), gauge(pct), f"{pct:.1f}%", when)
    if not rows:
        t.add_row(Text("no window data", style="dim"), "", "", "", "")
    return t, rows


def pace_table(rows, now=None):
    """Burn rate and prediction side by side, divided, sharing one label column."""
    t = Table(box=None, pad_edge=False, padding=(0, 1, 1, 1), show_edge=False,
              header_style="bold")
    t.add_column("", width=18)
    t.add_column("🔥 Burn Rate", width=22)
    t.add_column("│", width=1, style="dim")
    t.add_column("🔮 Prediction")

    now = now or datetime.now().astimezone()
    for prov, w in rows:
        label = f"{prov} {(w.get('label') or w.get('id') or '')}".strip()
        pace = w.get("pace") if isinstance(w.get("pace"), dict) else {}

        burn = pace.get("burnMultiple")
        left = Text()
        if isinstance(burn, (int, float)):
            style = "green" if burn < 0.9 else ("cyan" if burn <= 1.1 else "red")
            word = ("under budget" if burn < 0.9
                    else ("on budget" if burn <= 1.1 else "OVER ⚡"))
            left.append(f"{burn:.2f}×  ", style=style)
            left.append(word, style="dim")
        else:
            left.append("—  no pace data", style="dim")

        out = as_local(pace.get("projectedExhaustedAt"))
        reset = as_local(w.get("resetsAt"))
        right = Text()
        if out and reset and out < reset:
            early = (reset - out).total_seconds() / 3600
            right.append(f"runs dry {out.strftime('%a %H:%M')}", style="red")
            right.append(f"  ·  {span(early)} early", style="dim")
        elif reset:
            right.append("lasts through reset", style="green")
            right.append(f"  ·  {span((reset - now).total_seconds() / 3600)} to go",
                         style="dim")
        else:
            right.append("no projection", style="dim")

        t.add_row(label, left, "│", right)
    return t


def payg_table(bal, avail, legacy_auth=False, now=None):
    t = Table(box=None, pad_edge=False, show_header=False, padding=(0, 1, 1, 1))
    t.add_column(width=18)
    t.add_column(width=2)
    t.add_column()
    if isinstance(bal, str):
        note = "no key configured" if bal == "unconfigured" else "balance unreachable"
        t.add_row("DeepSeek", "⚪", Text(note, style="dim"))
    else:
        now = now or datetime.now().astimezone()
        peak = now.astimezone(timezone.utc).hour in DEEPSEEK_PEAK_HOURS_UTC
        ok = avail != "no"
        line = Text()
        line.append(f"${bal['total_balance']}", style="green" if ok else "red")
        if not ok:
            line.append("   UNUSABLE — top up before routing work here", style="red")
        t.add_row("DeepSeek balance", "🟢" if ok else "🔴", line)

        price = Text()
        if peak:
            price.append("⚡ PEAK — 2× price, route elsewhere", style="yellow")
        else:
            price.append("off-peak — base price", style="green")
        t.add_row("", "", price)
    if legacy_auth:
        t.add_row("Auth", "↪", Text(
            "using ~/.pi/agent/auth.json; migrate to ~/.quota-dash/auth.json",
            style="dim"))
    return t


def deepseek_history_table(records):
    t = Table(box=None, pad_edge=False, padding=(0, 1, 1, 1), show_edge=False,
              header_style="bold")
    t.add_column("Date", width=12)
    t.add_column("Usage", justify="right", width=12)
    t.add_column("Top-ups", justify="right", width=12)
    t.add_column("Observation")

    days, events, _ = deepseek_history(records)
    if not days:
        t.add_row("—", "—", "—", Text("no history yet", style="dim"))
        return t
    shown = days[-7:]
    usage = sum((values["usage"] for _, values in shown), Decimal(0))
    burn = usage / len(shown)
    for day, values in shown:
        observation = f"{values['samples']} sample{'s' if values['samples'] != 1 else ''}"
        if values["gap"]:
            observation += "  ·  after gap *"
        t.add_row(day.isoformat(), f"${values['usage']:.2f}",
                  f"${values['topups']:.2f}", observation)
    t.add_row("", "", "", "")
    t.add_row("Usage burn", f"${burn:.2f}/day", "",
              f"{len(shown)} sampled calendar day{'s' if len(shown) != 1 else ''}")
    if events:
        latest_at, latest_amount = events[-1]
        t.add_row("Latest top-up", "", f"${latest_amount:.2f}",
                  latest_at.astimezone().strftime("%a %d %b %H:%M"))
    if any(values["gap"] for _, values in shown):
        t.add_row("*", "", "", Text(
            "change assigned when observed; exact day unknown", style="dim"))
    return t


# -------------------------------------------------------------------- render
def render_dashboard(data, bal, avail, history, legacy_auth=False, now=None):
    """Build a dashboard from supplied data (also used by the SVG renderer)."""
    now = now or datetime.now().astimezone()
    live = [p for p in data.get("providers", []) if p.get("source") != "unavailable"]
    asleep = [p.get("provider") for p in data.get("providers", [])
              if p.get("source") == "unavailable"]

    wtable, rows = windows_table(live, now)
    tag = "  ·  ".join(f"{p.get('provider')} {p.get('plan', '')}".strip() for p in live)

    body = Group(
        Text(tag, style="dim"),
        Text(),
        heading("📊", "Subscription Windows", "capacity left before each window resets"),
        Rule(style="grey30"),
        wtable,
        Text(),
        heading("⏱", "Pace", "1.00× spends the window exactly as it elapses"),
        Rule(style="grey30"),
        pace_table(rows, now),
        Text(),
        heading("💰", "Pay-as-you-go", "no window to spend down — only a balance"),
        Rule(style="grey30"),
        payg_table(bal, avail, legacy_auth, now),
        Text(),
        heading("📅", "DeepSeek History", "directions stay separate; burn uses usage only"),
        Rule(style="grey30"),
        deepseek_history_table(history),
    )

    foot = Text()
    foot.append(f"⏰ {now.strftime('%H:%M:%S')}   ")
    foot.append(f"📡 {len(live)} live", style="green")
    if asleep:
        foot.append(f"   💤 {', '.join(asleep)}", style="dim")
    foot.append(f"   refresh {INTERVAL}s · Ctrl+C to exit", style="dim")

    return Panel(Group(body, Text(), Align.left(foot)),
                 title="[bold]✦ AGENT CAPACITY ✦[/bold]",
                 subtitle=f"[dim]{now.strftime('%a %d %b')}[/dim]",
                 border_style="cyan", padding=(1, 2))


def frame():
    data = read_quota()
    bal, avail, legacy_auth = read_deepseek()
    now = datetime.now().astimezone()

    if isinstance(bal, dict):
        try:
            append_history(bal)
        except (KeyError, OSError, TypeError, ValueError):
            pass
    history = load_history()

    if data is None:
        return Panel(Text("quota-axi returned nothing readable — is it authenticated?",
                          style="red"), title="AGENT CAPACITY", border_style="red")
    return render_dashboard(data, bal, avail, history, legacy_auth, now)


class ScrollView:
    """Render a full dashboard through a terminal-sized scrolling viewport."""

    def __init__(self, content):
        self.content = content
        self.offset = 0
        self.page_size = 1
        self.max_offset = 0

    def update(self, content):
        self.content = content

    def scroll(self, amount):
        self.offset = min(self.max_offset, max(0, self.offset + amount))

    def home(self):
        self.offset = 0

    def end(self):
        self.offset = self.max_offset

    def __rich_console__(self, rich_console, options):
        height = options.height or rich_console.height
        full = rich_console.render_lines(
            self.content, options.update(height=None), pad=True)
        total = len(full)
        clipped = total > height
        self.page_size = max(1, height - 1 if clipped else height)
        self.max_offset = max(0, total - self.page_size)
        self.offset = min(max(0, self.offset), self.max_offset)

        for line in full[self.offset:self.offset + self.page_size]:
            yield from line
            yield Segment.line()

        if clipped:
            first = self.offset + 1
            last = min(total, self.offset + self.page_size)
            edges = (("↑" if self.offset else " ")
                     + ("↓" if self.offset < self.max_offset else " "))
            indicator = Text(
                f" {edges} lines {first}–{last} of {total}"
                " · ↑/↓ or j/k · PgUp/PgDn · Home/End",
                style="reverse",
                overflow="ellipsis",
                no_wrap=True,
            )
            indicator_lines = rich_console.render_lines(
                indicator, options.update(height=1), pad=True)
            yield from indicator_lines[0]
            yield Segment.line()


KEYS = {
    b"\x1b[A": "up",
    b"\x1b[B": "down",
    b"\x1b[5~": "page_up",
    b"\x1b[6~": "page_down",
    b"\x1b[H": "home",
    b"\x1bOH": "home",
    b"\x1b[1~": "home",
    b"\x1b[7~": "home",
    b"\x1b[F": "end",
    b"\x1bOF": "end",
    b"\x1b[4~": "end",
    b"\x1b[8~": "end",
    b"j": "down",
    b"k": "up",
}


def read_key(fd, timeout):
    """Read one terminal key, returning None when the refresh timer expires."""
    try:
        ready, _, _ = select.select([fd], [], [], max(0, timeout))
    except InterruptedError:
        return None
    if not ready:
        return None
    key = os.read(fd, 32)
    if key == b"\x03":
        raise KeyboardInterrupt
    return KEYS.get(key)


@contextlib.contextmanager
def terminal_keys(stream=sys.stdin):
    """Put a terminal in cbreak mode and restore it on every exit path."""
    fd = stream.fileno()
    original_mode = termios.tcgetattr(fd)
    original_sigterm = signal.getsignal(signal.SIGTERM)

    def exit_on_sigterm(_signum, _frame):
        raise SystemExit(128 + signal.SIGTERM)

    try:
        signal.signal(signal.SIGTERM, exit_on_sigterm)
        tty.setcbreak(fd)
        yield fd
    finally:
        try:
            termios.tcsetattr(fd, termios.TCSADRAIN, original_mode)
        finally:
            signal.signal(signal.SIGTERM, original_sigterm)


def _apply_key(viewport, key):
    if key == "up":
        viewport.scroll(-1)
    elif key == "down":
        viewport.scroll(1)
    elif key == "page_up":
        viewport.scroll(-viewport.page_size)
    elif key == "page_down":
        viewport.scroll(viewport.page_size)
    elif key == "home":
        viewport.home()
    elif key == "end":
        viewport.end()


def main():
    try:
        if not (sys.stdin.isatty() and console.is_terminal):
            with Live(frame(), console=console, refresh_per_second=4,
                      screen=True) as view:
                while True:
                    time.sleep(INTERVAL)
                    view.update(frame())
            return

        viewport = ScrollView(frame())
        with terminal_keys() as fd:
            with Live(viewport, console=console, refresh_per_second=4,
                      screen=True) as live:
                next_refresh = time.monotonic() + INTERVAL
                while True:
                    key = read_key(fd, next_refresh - time.monotonic())
                    if key:
                        _apply_key(viewport, key)
                        live.refresh()
                    if time.monotonic() >= next_refresh:
                        viewport.update(frame())
                        live.refresh()
                        next_refresh = time.monotonic() + INTERVAL
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
